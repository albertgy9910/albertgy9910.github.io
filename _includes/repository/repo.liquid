{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.repository }}" target="_blank" rel="noopener noreferrer">
    <div class="card hoverable" style="height: 100%; display: flex; align-items: center; justify-content: center;">
      <div class="card-body" style="padding: 1.5rem;">
        <h5 class="card-title" style="margin-bottom: 0; font-weight: bold;">
          {% if show_owner %}
            <span style="font-weight: normal; font-size: 0.9em;">{{ repo_url[0] }} /</span>
          {% endif %}
          {{ repo_url[1] }}
        </h5>
      </div>
    </div>
  </a>
</div>
