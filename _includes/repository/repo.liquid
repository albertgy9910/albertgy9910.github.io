{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.repository }}" target="_blank" rel="noopener noreferrer">
    <div class="card hoverable">
      <div class="card-body">
        <h5 class="card-title">
          {% if show_owner %}
            {{ repo_url[0] }} /
          {% endif %}
          {{ repo_url[1] }}
        </h5>
        <p class="card-text">
          <img src="https://img.shields.io/github/stars/{{ include.repository }}?style=social" alt="GitHub stars">
          <img src="https://img.shields.io/github/forks/{{ include.repository }}?style=social" alt="GitHub forks">
        </p>
      </div>
    </div>
  </a>
</div>
